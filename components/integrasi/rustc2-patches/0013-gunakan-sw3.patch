diff --git a/client/build.rs b/client/build.rs
new file mode 100644
index 0000000..8ad3f1a
--- /dev/null
+++ b/client/build.rs
@@ -0,0 +1,37 @@
+use std::env;
+use std::path::PathBuf;
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rerun-if-changed=syswhispers/swdefault.c");
+    println!("cargo:rerun-if-changed=syswhispers/swdefault.h");
+    println!("cargo:rerun-if-changed=syswhispers/swdefault-asm.x64.asm");
+
+    cc::Build::new()
+        .file("syswhispers/swdefault.c")
+        .compile("syscalls");
+
+    let out_dir = PathBuf::from(env::var_os("OUT_DIR").unwrap());
+
+    let asm_obj = out_dir.join("swdefault-asm.x64.obj");
+
+    let llvm_prefix = std::env::var("LLVM_PREFIX")
+        .unwrap_or_else(|_| "/opt/homebrew/opt/llvm".to_string());
+
+    let llvm_ml = PathBuf::from(llvm_prefix).join("bin/llvm-ml");
+
+    let status = Command::new(&llvm_ml)
+        .args([
+            "-m64",
+            "-c",
+            "syswhispers/swdefault-asm.x64.asm",
+            "-Fo",
+        ])
+        .arg(&asm_obj)
+        .status()
+        .expect("failed to execute llvm-ml");
+
+    assert!(status.success(), "llvm-ml failed");
+
+    println!("cargo:rustc-link-arg={}", asm_obj.display());
+}
