From b9ee56bf8071e1d7940c2441060ad207867b9cfd Mon Sep 17 00:00:00 2001
From: Ron Panduwana <panduwana@gmail.com>
Date: Wed, 21 Oct 2026 10:09:05 +0700
Subject: [PATCH 10/10] fix build warnings

---
 Cargo.toml                        | 8 ++++++++
 inject/Cargo.toml                 | 7 -------
 inject/vendor/unwinder/Cargo.toml | 7 -------
 3 files changed, 8 insertions(+), 14 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 7260729..f8794f9 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,3 +1,5 @@
+cargo-features = ["profile-rustflags"]
+
 [workspace]
 resolver = "2"
 members = [
@@ -18,9 +20,15 @@ codegen-units = 1   # Reduce number of codegen units to increase optimizations.
 panic = "abort"     # Abort on panic
 strip = true        # Automatically strip symbols from the binary.
 
+[profile.release.package.inject]
+rustflags = ["-Zllvm-plugins=../../submodules/amice/target/release/libamice.dylib"]
+
 [profile.dev]
 opt-level = "z"     # Optimize for size.
 lto = true          # Enable Link Time Optimization
 codegen-units = 1   # Reduce number of codegen units to increase optimizations.
 panic = "abort"     # Abort on panic
 strip = true        # Automatically strip symbols from the binary.
+
+[profile.dev.package.unwinder]
+debug-assertions = false
diff --git a/inject/Cargo.toml b/inject/Cargo.toml
index c346c6d..9aa6b87 100644
--- a/inject/Cargo.toml
+++ b/inject/Cargo.toml
@@ -1,4 +1,3 @@
-cargo-features = ["profile-rustflags"]
 [package]
 name = "inject"
 version = "0.1.0"
@@ -24,12 +23,6 @@ rand = "0.8.5"
 rand_core = "0.6.4"
 base64 = { version = "0.22.1", features = ["std"] }
 
-[profile.release]
-codegen-units = 1
-
-[profile.release.package.inject]
-rustflags = ["-Zllvm-plugins=../../../submodules/amice/target/release/libamice.dylib"]
-
 [dependencies.windows-sys]
 version = "0.52.0"
 features = [
diff --git a/inject/vendor/unwinder/Cargo.toml b/inject/vendor/unwinder/Cargo.toml
index 2aa85b9..b096e83 100644
--- a/inject/vendor/unwinder/Cargo.toml
+++ b/inject/vendor/unwinder/Cargo.toml
@@ -30,13 +30,6 @@ keywords = [
 license = "MIT"
 repository = "https://github.com/Kudaes/Unwinder"
 
-[profile.dev]
-debug-assertions = false
-
-[profile.release]
-debug-assertions = false
-strip = true
-
 [lib]
 name = "unwinder"
 path = "src/lib.rs"
-- 
