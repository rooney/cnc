+        let mut addr = ptr::null_mut::<c_void>();
+        let mut size = (1 << 12) as usize;
+        let status = syscall!("NtAllocateVirtualMemory", -1isize, addr.as_ptr_mut(), 0, size.as_ptr_mut(), 0x3000, 0x04)? as i32;
+        assert_eq!(status, 0);
+
+        Ok(())
+    }
