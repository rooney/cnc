+	mov		rdx, [rcx].SPOOFER.Arg02
+	jmp		handle_one
+handle_two endp
+handle_one proc
+	cmp		[rcx].SPOOFER.Sys, 0
+	jne		execute_syscall
+	mov		rcx, [rcx].SPOOFER.Arg01
+	jmp		handle_none
+handle_one endp
+
+handle_none proc
+	jmp		execute
+handle_none endp
+
+execute proc
+	jmp		qword ptr r11
+execute endp
+
+execute_syscall proc
+	mov 	r10, [rcx].SPOOFER.Arg01
+	mov 	eax, [rcx].SPOOFER.SysId
+	mov 	rcx, [rcx].SPOOFER.Arg01
+	jmp 	qword ptr r11
+execute_syscall endp
+
+end
