+#[cfg(windows)]
+use winreg::enums::*;
+#[cfg(windows)]
+use winreg::RegKey;
+
+#[cfg(windows)]
+pub fn check_vm_artifacts() {
+    // Checking for common VMware registry keys
+    let hklm = RegKey::predef(HKEY_LOCAL_MACHINE);
+    
+    // VMware Tools key
+    if let Ok(_key) = hklm.open_subkey("SOFTWARE\\VMware, Inc.\\VMware Tools") {
+        println!("VMware detected! Exiting program.");
+        exit(1);
+    }
+    
+    // System BIOS Version for VMware indicator
+    if let Ok(key) = hklm.open_subkey("HARDWARE\\Description\\System") {
+        if let Ok(bios_version) = key.get_value::<String, _>("SystemBiosVersion") {
+            if bios_version.contains("VMware") {
+                println!("VMware detected! Exiting program.");
+                exit(1);
+            }
+        }
+    }
+}
